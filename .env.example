# Atlas Builder configuration.
#
# Copy to .env.local for development. .env* is gitignored — never commit a real
# key. See docs/atlas-builder-deployment.md.
#
# The operator area FAILS CLOSED: with these unset, every path under /operator
# returns 404 in every environment. That is deliberate, not a bug to work
# around — the Builder refuses to serve without a database and auth server to
# enforce its access rules.

# --- Public. Safe in a browser bundle; protected by row-level security. -------

# Local Supabase prints this as API URL from `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The anon key. Grants nothing on its own — RLS decides what the session behind
# it can see. Read it from `npm run db:status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only. NEVER prefix with NEXT_PUBLIC_. -----------------------------

# BYPASSES ROW-LEVEL SECURITY ENTIRELY.
#
# Used only by scripts (atlas:export, atlas:import-file-drafts) and the RLS test
# harness. lib/atlas/builder/supabase/admin.ts throws if it is constructed
# inside a Next.js runtime, because a request path that needs this key has a
# policy bug rather than a configuration gap.
#
# In production this belongs in the deployment platform's secret store, scoped
# to build/CI, and NOT in the runtime environment of the web app — nothing the
# app serves needs it.
SUPABASE_SERVICE_ROLE_KEY=
