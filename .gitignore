# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which contains no secrets and is how a new operator
# learns which variables exist. Without this exception the Builder's whole
# configuration contract would be undiscoverable from the repository.
!.env.example

# vercel
.vercel

# Atlas Builder private workspace.
#
# Unpublished drafts, private source annotations, and operator notes. This
# directory is the private tier of the builder and must never be committed:
# keeping it out of the repository is what guarantees draft material cannot
# reach production, since Vercel deploys from the repo and its filesystem is
# read-only. Published releases live in content/atlas-releases/ and ARE
# committed. See docs/atlas-builder.md.
/.atlas-builder/

# typescript
*.tsbuildinfo
next-env.d.ts
